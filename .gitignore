/target
/data
*.log
.env

# cargo-mutants working output, rewritten on every run.
mutants.out/
mutants.out.old/

# The frontend build output. Produced by `npm run build` in web/ and embedded
# into the radar-serve binary at compile time, so it is a build artifact rather
# than a source. The directory itself is tracked (see web/dist/.gitkeep) because
# rust-embed needs it to exist for the crate to compile at all -- a fresh
# checkout must build without anyone having run npm.
web/dist/*
!web/dist/.gitkeep
web/node_modules/
tsconfig.tsbuildinfo
web/tsconfig.tsbuildinfo

# Release binaries downloaded for a deploy. `deploy/README.md` says to fetch
# them with `gh run download --dir ./dist`, so this path is created by following
# the runbook -- and a 12 MB binary swept in by `git add -A` is the same accident
# that put an untracked research document into two pull requests.
/dist

# The creator index is a measurement built where the data is, not a source
# file. 13MB, and it changes every six hours on the box -- committing one would
# be committing a snapshot of production that is stale the moment it lands.
# `deploy/README.md` says where it comes from.
docs/research/data/creator-index.json
