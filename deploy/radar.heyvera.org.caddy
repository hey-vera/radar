# SPDX-License-Identifier: Apache-2.0
#
# Append to /home/guardian/claw-net/Caddyfile, then:
#   sudo cp /home/guardian/claw-net/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Both of those are already in guardian's NOPASSWD sudoers list, so no privilege
# change is needed for the web route itself.

radar.heyvera.org {
	reverse_proxy localhost:8402 {
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# The ops page is self-contained: one inline stylesheet, no scripts, no
		# external loads. Token names are creator-supplied and are escaped before
		# rendering, but a policy that forbids script outright means a missed
		# escape is a rendering bug rather than a compromise.
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'"
	}

	encode zstd gzip
}
