# SPDX-License-Identifier: Apache-2.0
#
# Install to /etc/radar/radar.env (root-owned, 0640, group guardian).
#
# Nothing secret belongs here yet. When the trading lane arrives its signing key
# will NOT live in this file -- the signer is a separate process with its own
# unit and its own credentials, so that a compromise of the read-only server
# cannot reach it.

RADAR_STORE=/home/guardian/radar/data/store
RADAR_BIND=127.0.0.1:8402

# The x402 paid surface stays off until both of these are set. Leaving them
# unset is the safe default: the routes do not exist rather than being served
# free.
# RADAR_X402_PAY_TO=
# RADAR_X402_FACILITATOR=
# RADAR_X402_MARGIN_PERCENT=50

# --- Who may look -------------------------------------------------------------
#
# radar-serve REFUSES TO START unless one of the two blocks below is present.
# That is deliberate and it is the one setting with no default: serving to
# everyone looks like it works, and refusing everyone looks like a broken
# deploy, so neither can be what happens when nobody decided.
#
# To verify Cloudflare Access tokens (the private deployment). AUD is the
# application's Application Audience tag, from the Access application's
# Overview page -- NOT the team name, and not the same for two applications.
# RADAR_ACCESS_TEAM=heyvera.cloudflareaccess.com
# RADAR_ACCESS_AUD=

# To serve without checking anyone. Only correct once there is a public
# surface that is meant to be public.
# RADAR_ACCESS=off

# --- The reading assistant ----------------------------------------------------
#
# Off unless a provider AND a budget are set. A model with no budget spends
# without a ceiling, so the budget is required rather than defaulted.
#
# RADAR_MODEL_DAILY_USD=2.00
# RADAR_MODEL_PER_CALL_USD=0.25
#
# Exactly one of the two provider blocks. Setting both is refused rather than
# resolved: an operator who set a key to move off the subscription and forgot to
# unset the old variable is still on the subscription, and nothing would say so.
#
# Subscription, private use only. Radar spawns this and never reads a
# credential; the CLI owns auth.json and its own refresh. Point it at a wrapper
# that drops to another user so the boundary is one the kernel enforces.
#
# This is the BASE command: Radar appends the subcommand, because it runs two
# of them -- `exec -` to ask and `login --device-auth` to link from the
# interface. The wrapper must pass "$@" through.
# RADAR_MODEL_CODEX=/usr/local/bin/radar-codex
#
# Metered. Prices are micro-dollars per million tokens and have no default,
# because a default price is a spending decision made by whoever wrote the code.
# RADAR_MODEL_API_KEY=
# RADAR_MODEL_ENDPOINT=https://api.anthropic.com/v1/messages
# RADAR_MODEL_NAME=
# RADAR_MODEL_PRICE_IN=
# RADAR_MODEL_PRICE_OUT=

# --- The customer lane --------------------------------------------------------
#
# Setting RADAR_PRIVY_APP_ID switches customer authentication ON. From that
# moment a valid Privy token for that application reaches every customer route
# *without* a Cloudflare Access cookie -- Access is the fallback, not the gate.
#
# So the three settings below are not optional extras. Without them an instance
# with a Privy app id configured is open to anyone who signs up to that Privy
# application.

# Which verified identities may reach the product. NO DEFAULT, and unset means
# NOBODY -- deliberately, because the alternative is that a dropped variable on
# one deploy silently opens a private product.
#
#   closed                          nobody (same as unset)
#   allowlist:did:privy:a,did:privy:b   only those identities
#   open                            anyone with a valid token
#
# Going public is `open`, which someone has to type. It is not the absence of a
# line.
#
# Finding your own DID: it is the `sub` of your Privy access token, and it is
# listed against your user in the Privy dashboard. An identity that is refused
# is told its own DID in the 403 body, so it can be added -- but note that an
# operator holding an Access cookie is served by the Access check instead and
# will not see that response.
# RADAR_CUSTOMER_ACCESS=closed

# The salt customer identifiers are hashed with before anything durable records
# them. At least 32 bytes. Unset means customers cannot be metered, and an
# instance that cannot meter a customer will not spend on one.
#
# Generate one and keep it: changing it resets every meter, because the subjects
# stop matching.
#
#   head -c 48 /dev/urandom | base64
#
# RADAR_CUSTOMER_SALT=

# How many questions one customer may ask the reading assistant per day. NO
# DEFAULT, and unset means NO CUSTOMER MAY CHAT -- not "share the operator's
# budget", which is how the first account to open a loop spends the whole day
# for everybody. A value that is not a whole number stops the server rather than
# resolving to closed, because a typo and a deliberate zero are otherwise
# indistinguishable.
#
# This is a share of the global RADAR_MODEL_DAILY_USD ceiling, not a second
# budget. Both apply.
# RADAR_CHAT_PER_CUSTOMER_DAILY=25

# Privy itself. The app id is not a secret -- it ships in the client bundle --
# but it is the audience every token is checked against, so a wrong one accepts
# tokens issued for somebody else's application.
# RADAR_PRIVY_APP_ID=
# RADAR_PRIVY_APP_SECRET=
